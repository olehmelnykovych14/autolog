{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "autolog.com.ua" }],
      "destination": "https://www.autolog.com.ua/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "https://autolog-q9hd.onrender.com/api/ai"
    },
    {
      "source": "/api/transfer",
      "destination": "https://autolog-q9hd.onrender.com/api/transfer"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://autolog-api-prod.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
