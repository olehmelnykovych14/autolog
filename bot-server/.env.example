# Backend Environment Variables (Render)
PORT=3000
BOT_TOKEN=ваш_токен_від_BotFather
GEMINI_API_KEY=ваш_ключ_від_Gemini
# Telegram user id(и) адмінів через кому — лише вони можуть запускати
# деструктивні команди (/cleandb, /migrate, /keepcar). Дізнатись свій id: /whoami
ADMIN_TELEGRAM_IDS=
WAYFORPAY_MERCHANT_LOGIN=ваш_логін_wayforpay
WAYFORPAY_MERCHANT_SECRET=ваш_секрет_wayforpay
MERCHANT_DOMAIN_NAME=ваш_домен_vercel_app
# Весь вміст serviceAccountKey.json у вигляді одного рядка JSON
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
